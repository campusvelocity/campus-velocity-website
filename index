<style>
    :root {
        --void:      #0D1117;
        --card:      #1E2329;
        --near-black:#1A1A1A;
        --ghost:     #8892A4;
        --terminal:  #00B4A6;
        --signal:    #F59E0B;
        --error:     #EF4444;
        --border:    #2D3748;
    }
    * { box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background-color: var(--void); color: #ffffff; }
    .font-mono  { font-family: 'IBM Plex Mono', monospace; }
    .bg-void        { background-color: var(--void); }
    .bg-card        { background-color: var(--card); }
    .border-charcoal{ border-color: var(--border); }
    .text-ghost     { color: var(--ghost); }
    .text-terminal  { color: var(--terminal); }
    .text-signal    { color: var(--signal); }
    .text-error     { color: var(--error); }
    .bg-terminal    { background-color: var(--terminal); }
    .hero-pattern {
        background-color: var(--void);
        background-image: radial-gradient(var(--border) 1px, transparent 1px);
        background-size: 30px 30px;
    }
    ::-webkit-scrollbar { width: 6px; } ::-webkit-scrollbar-track { background: var(--void); }
    ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--terminal); }
    .step-dots { display: flex; gap: 5px; align-items: center; }
    .step-dot { width: 7px; height: 7px; border-radius: 50%; border: 2px solid var(--border); transition: all 0.3s; }
    .step-dot.active { background: var(--terminal); border-color: var(--terminal); }
    .glow-teal { box-shadow: 0 0 28px rgba(0,180,166,0.25); }
    @keyframes flicker { 0%,100% { opacity:1; } 92% { opacity:1; } 93% { opacity:0.85; } 94% { opacity:1; } }
    .flicker { animation: flicker 6s infinite; }
    @keyframes slideUp { from { opacity:0; transform: translateY(20px); } to { opacity:1; transform: translateY(0); } }
    .slide-up { animation: slideUp 0.7s ease both; }
    .delay-1  { animation-delay: 0.1s; } .delay-2  { animation-delay: 0.25s; }
    .delay-3  { animation-delay: 0.4s; } .delay-4  { animation-delay: 0.55s; }
    @keyframes borderPulse { 0%,100% { box-shadow: 0 0 0 0 rgba(0,180,166,0.4); } 50% { box-shadow: 0 0 0 6px rgba(0,180,166,0); } }
    .cta-pulse:hover { animation: borderPulse 1.2s ease infinite; }
    .tag { font-family: 'IBM Plex Mono', monospace; font-size: 10px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; border: 1px solid var(--border); padding: 3px 10px; border-radius: 999px; color: var(--ghost); background: var(--card); }
    .divider { border-color: var(--border); }
    .step-card { transition: border-color 0.2s; }
    .step-card:hover { border-color: var(--terminal); }
    .domain-card { transition: border-color 0.2s, transform 0.2s; }
    .domain-card:hover { border-color: var(--terminal); transform: translateY(-2px); }
    @keyframes badgeBlink { 0%,100% { opacity:1; } 50% { opacity:0.6; } }
    .badge-blink { animation: badgeBlink 2s ease-in-out infinite; }
</style>
</head>
